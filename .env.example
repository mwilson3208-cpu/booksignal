# ---------------------------------------------------------------------------
# BookSignal environment
#
# Copy to .env.local and fill in. The app boots and the marketing site renders
# with none of these set; each missing key disables its feature with a visible
# message rather than crashing.
# ---------------------------------------------------------------------------

# Public URL of this deployment. Used for Stripe redirects and auth callbacks.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (auth + database) --------------------------------------------
# Project Settings -> API. Without these, sign-up and every app route are off.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used solely by the Stripe webhook, which runs without a user
# session. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (subscriptions) ------------------------------------------------
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:3000/api/stripe/webhook`, or the
# endpoint's signing secret in the Stripe dashboard.
STRIPE_WEBHOOK_SECRET=

# One recurring price per plan and interval. Yearly prices should be ten times
# the monthly amount — that is what "two months free" means in src/lib/billing/plans.ts.
STRIPE_PRICE_STANDARD_MONTHLY=
STRIPE_PRICE_STANDARD_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=

# --- Anthropic (AI Publishing Coach) ---------------------------------------
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-sonnet-4-5.
ANTHROPIC_MODEL=
